{
  "name": "authcore-ts",
  "version": "0.1.0",
  "main": "./dist/index.cjs",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack . --profile node16",
    "build:example": "tsup --config tsup.example.config.ts",
    "demo:timing": "tsx scripts/demo-timing.ts",
    "demo:truncation": "tsx scripts/demo-truncation.ts",
    "demo:sessions": "tsx scripts/demo-sessions.ts",
    "prepare": "npm run build",
    "demo:race": "tsx scripts/demo-race.ts"
  },
  "keywords": [
    "auth",
    "authentication",
    "rbac",
    "session",
    "jwt",
    "bcrypt",
    "typescript",
    "password-reset"
  ],
  "author": "Raphael Gab-Momoh",
  "license": "MIT",
  "description": "Framework-agnostic TypeScript auth core: bcrypt password hashing, revocable signed sessions, typed RBAC, rate limiting and single-use reset tokens. Extracted from AssetOps.",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "pg": "^8.23.1",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphgm/authcore-ts.git"
  },
  "homepage": "https://github.com/raphgm/authcore-ts#readme",
  "bugs": {
    "url": "https://github.com/raphgm/authcore-ts/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ]
}
